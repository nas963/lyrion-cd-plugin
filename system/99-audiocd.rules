# AudioCD: kad se disk ubaci ili izvadi, pokrece se audiocd-notify@<uredjaj>.service.
# RUN+= systemctl start (a ne SYSTEMD_WANTS): SYSTEMD_WANTS na "change" dogadjaju sa istom instancom
# (@sr0) pokrene servis samo pri prvoj promeni posle boot-a. --no-block: udev ne ceka servis.
ACTION=="change", SUBSYSTEM=="block", KERNEL=="sr[0-9]*", RUN+="/usr/bin/systemctl start --no-block audiocd-notify@%k.service"
